PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_nest
FRONTEND_URL=http://localhost:3000
# Comma-separated exact browser origins. FRONTEND_URL is used when omitted.
# FRONTEND_URLS=https://app.example.com,https://staging.example.com
# Set to the proxy hops in front of Express (commonly 1 on managed hosting).
# TRUST_PROXY=1
# Use none only when frontend and API are on different sites; HTTPS is required.
SESSION_COOKIE_SAME_SITE=lax
# Optional parent domain, for example .example.com
# SESSION_COOKIE_DOMAIN=

# Per-client fixed-window limits. Use a shared Redis-backed limiter when
# running more than one backend instance.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RECOVERY_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=30
SESSION_CLEANUP_INTERVAL_MS=3600000

# Transactional email. Verify the EMAIL_FROM domain in Resend.
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Memory Nest <hello@example.com>

# Private Amazon S3 bucket used for photos and videos.
AWS_REGION=eu-west-1
AWS_S3_BUCKET=replace-with-your-private-bucket-name
# Backward-compatible alias: AWS_BUCKET_NAME

# For local development only. In AWS, prefer an IAM role and omit these values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional S3-compatible endpoint overrides (not needed for AWS S3).
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# Required in production. The ClamAV StreamMaxLength must exceed 250 MB.
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
CLAMAV_REQUIRED=false
