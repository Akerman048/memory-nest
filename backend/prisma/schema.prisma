generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChildMemberRole {
  PARENT
  GUARDIAN
  VIEWER
}

enum AccountRole {
  PARENT
  GUARDIAN
  FAMILY_MEMBER
  OTHER
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  email            String        @unique
  passwordHash     String
  accountRole      AccountRole
  childMemberships ChildMember[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Child {
  id        Int           @id @default(autoincrement())
  name      String
  birthDate DateTime?
  members   ChildMember[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChildMember {
  userId    Int
  childId   Int
  role      ChildMemberRole @default(PARENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([userId, childId])
  @@index([childId])
}
