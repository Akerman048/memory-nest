generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChildMemberRole {
  PARENT
  GUARDIAN
  VIEWER
}

enum AccountRole {
  PARENT
  GUARDIAN
  FAMILY_MEMBER
  OTHER
}

enum MemoryKind {
  PHOTO
  VIDEO
  NOTE
  MILESTONE
}

enum MediaStatus {
  PENDING
  READY
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  email            String        @unique
  passwordHash     String
  accountRole      AccountRole
  sessions         Session[]
  childMemberships ChildMember[]
  memories         Memory[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Child {
  id                Int           @id @default(autoincrement())
  name              String
  birthDate         DateTime?
  expectedBirthDate DateTime?
  members           ChildMember[]
  memories          Memory[]
  mediaAssets       MediaAsset[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Memory {
  id           String      @id @default(uuid())
  childId      Int
  authorId     Int
  mediaAssetId String?     @unique
  kind         MemoryKind
  title        String
  description  String      @default("")
  capturedAt   DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([childId, capturedAt])
  @@index([authorId])
}

model MediaAsset {
  id          String      @id @default(uuid())
  childId     Int
  objectKey   String      @unique
  fileName    String
  contentType String
  sizeBytes   Int
  status      MediaStatus @default(PENDING)
  uploadedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  memory Memory?

  @@index([childId, status])
}

model ChildMember {
  userId    Int
  childId   Int
  role      ChildMemberRole @default(PARENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([userId, childId])
  @@index([childId])
}
